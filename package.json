{
  "name": "vfx-maker",
  "version": "0.7.3",
  "description": "Visual VFX authoring with React, PixiJS, a standalone CLI and MCP server",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "vfx": "dist/cli.js",
    "vfx-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./renderer": {
      "types": "./dist/render/pixi.d.ts",
      "import": "./dist/renderer.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "format": "prettier --write src tests scripts package.json *.ts *.html docs/*.md README.md",
    "format:check": "prettier --check src tests scripts package.json *.ts *.html docs/*.md README.md",
    "prepack": "npm run build",
    "build:notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "commander": "14.0.3",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "pako": "2.1.0",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.22.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "upng-js": "2.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.0",
    "@types/pako": "2.0.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/upng-js": "2.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "gifuct-js": "2.1.2",
    "pngjs": "7.0.0",
    "prettier": "3.9.0",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
